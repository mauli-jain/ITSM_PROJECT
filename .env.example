# JWT_SECRET: Strong secret key used for signing JSON Web Tokens (minimum 32 characters)
JWT_SECRET="replace-with-a-random-32+-char-string"

# GEMINI_API_KEY: (Optional) Google Gemini API key for smart category & resolution hints.
# If omitted or invalid, the system automatically falls back to the deterministic rule-based AI provider.
# GEMINI_API_KEY=""

# PORT: Server listening port (defaults to 3000)
PORT=3000

# NODE_ENV: Application environment (development | production | test)
NODE_ENV=development
